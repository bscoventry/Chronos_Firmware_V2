/*
 * Network core (cpunet) overlay for nRF5340 DK.
 *
 * Moves the network core UART from P1.00/P1.01 to P0.19 (TX) and P0.21 (RX)
 * so that P1.00 and P1.01 can be used by the application core for the switch
 * (medical device). CPUNET has uart0 only (no uart1).
 *
 * Application UART0 (NUS) uses P0.23/P0.25; see app.overlay.
 */

&uart0 {
	status = "okay";
	pinctrl-0 = <&uart0_cpunet_p0_19_p0_21>;
	pinctrl-1 = <&uart0_cpunet_p0_19_p0_21_sleep>;
	pinctrl-names = "default", "sleep";
};

&pinctrl {
	uart0_cpunet_p0_19_p0_21: uart0_cpunet_p0_19_p0_21 {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 19)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 21)>;
			bias-pull-up;
		};
	};

	uart0_cpunet_p0_19_p0_21_sleep: uart0_cpunet_p0_19_p0_21_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 19)>,
				<NRF_PSEL(UART_RX, 0, 21)>;
			low-power-enable;
		};
	};
};

&gpiote1 {
	status = "okay";
};

/* Do NOT disable &gpiote here. This overlay is merged into the app build (cpuapp+cpunet);
 * the app uses GPIO0 (DAC CS, switch, etc.) which requires GPIOTE0. Disabling it caused
 * "Please enable GPIOTE instance for used GPIO port!" and NRFX_GPIOTE0_INST_IDX undeclared. */

&dppic0 {
	status = "disabled";
};

/* Do NOT disable &mbox here. This overlay is merged into the app build (cpuapp+cpunet);
 * the app needs mbox enabled for BLE-over-IPC. Disabling it caused __device_dts_ord_25
 * undeclared. The ipc_radio (network) build uses this overlay only; base cpunet DTS
 * governs mbox there. */
