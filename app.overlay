/ {
	chosen {
		nordic,nus-uart = &uart00;
	};
};

/* NUS UART on P0.23 (TX), P0.25 (RX). P0.19/P0.21 are used by network core UART. */
&uart00 {
	status = "okay";
	pinctrl-0 = <&uart00_p0_23_p0_25>;
	pinctrl-1 = <&uart00_p0_23_p0_25_sleep>;
	pinctrl-names = "default", "sleep";
	current-speed = <115200>;
};

/* SPIM21: pinctrl matches nrfx DAC path (SCK P1.11, MOSI P1.06). App uses nrfx, not Zephyr SPI API. */
&spi21 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi21_default>;
	pinctrl-1 = <&spi21_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio1 8 GPIO_ACTIVE_LOW>;
	dac1: dac1@0 {
		reg = <0>;
		spi-max-frequency = <2000000>;
	};
};

/* UART1 (Arduino / P1.00–P1.01) disabled if needed; analog switch GPIOs are P1.05/P1.07/P1.13 */
//&uart10 {
	//status = "disabled";
//};

&pinctrl {
	uart00_p0_23_p0_25: uart00_p0_23_p0_25 {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 23)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 25)>;
			bias-pull-up;
		};
	};

	uart00_p0_23_p0_25_sleep: uart00_p0_23_p0_25_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 23)>,
				<NRF_PSEL(UART_RX, 0, 25)>;
			low-power-enable;
		};
	};

	/* SCK + MOSI only; MISO unused (DAC is TX-only). Do not tie MISO to P1.14 (DAC2 CS). */
	spi21_default: spi21_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 11)>,
				<NRF_PSEL(SPIM_MOSI, 1, 6)>,
				<NRF_PSEL_DISCONNECTED(SPIM_MISO)>;
		};
	};

	spi21_sleep: spi21_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 11)>,
				<NRF_PSEL(SPIM_MOSI, 1, 6)>,
				<NRF_PSEL_DISCONNECTED(SPIM_MISO)>;
			low-power-enable;
		};
	};
};
