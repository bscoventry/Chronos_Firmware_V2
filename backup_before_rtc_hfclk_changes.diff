diff --git a/prj.conf b/prj.conf
index 8b13789..279d93c 100644
--- a/prj.conf
+++ b/prj.conf
@@ -1 +1,65 @@
+##############################################################################
+# BLE ON/OFF
+##############################################################################
+CONFIG_BT=n
+#CONFIG_BT_NUS_SECURITY_ENABLED=n
 
+##############################################################################
+# Peripherals: GPIO, SPIM1, TIMER0 (burst), TIMER2 (period)
+##############################################################################
+#CONFIG_NRFX=y
+CONFIG_DEVICE_DT_METADATA=n
+# Keep deps off to avoid device ordinal refs for disabled nodes (e.g. spi00).
+CONFIG_DEVICE_DEPS=n
+CONFIG_NRFX_SPIM=y
+CONFIG_NRFX_TIMER=y
+CONFIG_GPIO=y
+#CONFIG_SPI=y
+#CONFIG_NRFX_SPIM00=y
+CONFIG_NRFX_QSPI=n
+# TIMER: nRF54L15 uses TIMER20, TIMER22 etc. (enable per-instance in overlay if needed)
+#CONFIG_NRFX_TIMER0=y
+#CONFIG_NRFX_TIMER1=y
+
+# UART/SERIAL off when BLE off (code guarded by CONFIG_BT)
+# For SPI debug over UART console, enable serial temporarily.
+CONFIG_SERIAL=y
+#CONFIG_NRFX_UARTE00=n
+CONFIG_UART_ASYNC_API=n
+
+# DK LEDs/buttons off when BLE off (code guarded by CONFIG_BT)
+CONFIG_DK_LIBRARY=n
+
+##############################################################################
+# Console / log / debug
+##############################################################################
+# Enable UART console + printk so SPI init status is visible in
+# nRF Connect Serial Logger during bring-up.
+CONFIG_CONSOLE=y
+CONFIG_UART_CONSOLE=y
+CONFIG_PRINTK=y
+CONFIG_USE_SEGGER_RTT=n
+CONFIG_LOG=n
+CONFIG_DEBUG_THREAD_INFO=n
+CONFIG_ASSERT=n
+
+##############################################################################
+# Boot / size
+##############################################################################
+CONFIG_BOOT_BANNER=n
+CONFIG_NCS_BOOT_BANNER=n
+CONFIG_SIZE_OPTIMIZATIONS=y
+
+# Flash: keep FLASH=y for XIP; map/layout not needed when no settings
+CONFIG_FLASH=y
+CONFIG_FLASH_MAP=n
+CONFIG_FLASH_PAGE_LAYOUT=n
+# Disable SPI NOR driver to avoid device-ordinal errors with CONFIG_DEVICE_DEPS=n
+# when CONFIG_SPI=y (we use SPI for DACs, not external flash).
+CONFIG_SPI_NOR=n
+
+##############################################################################
+# Heap / stacks (reduced for no-BLE path)
+##############################################################################
+CONFIG_HEAP_MEM_POOL_SIZE=1024
+CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=1024
